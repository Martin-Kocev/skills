    "readingStage": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Stable, prefixed \"stage-\". Its position in the array is the graph row."
        },
        "name": {
          "type": "string"
        },
        "what": {
          "type": "string",
          "description": "One or two sentences: why these files belong together and what the stage buys the reader."
        }
      },
      "description": "One band of the reading-order graph. Order is meaningful: a node may only depend on nodes in this stage or an earlier one."
    },
    "readingNode": {
      "type": "object",
      "required": [
        "id",
        "stage",
        "title",
        "path",
        "what",
        "lookFor",
        "validate",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Stable, prefixed \"read-\". Progress is stored against it exactly like any section id."
        },
        "stage": {
          "type": "string",
          "description": "A readingOrder.stages[].id."
        },
        "title": {
          "type": "string",
          "description": "Usually the bare file name — the graph node is small."
        },
        "path": {
          "type": "string",
          "description": "Repository-relative path, validated against the recorded commit."
        },
        "what": {
          "type": "string",
          "description": "What this file is, in one sentence."
        },
        "lookFor": {
          "type": "string",
          "description": "The load-bearing idea in it — what a reader should come away holding."
        },
        "validate": {
          "type": "string",
          "description": "How to check the understanding: a test to run, a command, or a claim to confirm."
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Reading-order node ids this file assumes. MUST be earlier in the order (earlier stage, or earlier within the same stage) — that is what keeps the graph acyclic and makes the drawn layout correct by construction. Never a lock: an unmet prerequisite is drawn as a hint."
        },
        "fileId": {
          "type": "string",
          "description": "Optional explorer file id, so the node links into the rest of the atlas."
        },
        "componentId": {
          "type": "string",
          "description": "Optional island id."
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "changed": {
          "$ref": "#/$defs/changed"
        },
        "contentHash": {
          "type": "string"
        }
      },
      "description": "One file to read, and one node in the graph."
    }
  }
