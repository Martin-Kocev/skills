{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codebase-atlas/schema/1.0",
  "title": "Codebase Atlas data",
  "description": "Repository-derived content for an interactive Codebase Atlas. Presentation code reads this file and adds nothing to it. Prose guidance lives in references/schema.md.",
  "type": "object",
  "required": [
    "atlasSchemaVersion",
    "skillVersion",
    "repository",
    "meta",
    "learningPaths"
  ],
  "properties": {
    "atlasSchemaVersion": {
      "type": "string"
    },
    "skillVersion": {
      "type": "string"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "updateHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/update"
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "learningPaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/learningPath"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "auth": {
      "type": [
        "object",
        "null"
      ]
    },
    "subsystems": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "delivery": {
      "type": [
        "object",
        "null"
      ]
    },
    "changePlaybooks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "knowledgeChecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "explorer": {
      "type": "object",
      "description": "The levels below a top-level island: island → area/district → file/building. Conceptual groups are the landing view; the real folder tree is a toggle.",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/explorerGroup"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/explorerFile"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "enum": [
              "conceptual",
              "folders",
              "recently-changed",
              "current-workflow",
              "feature",
              "unexplored"
            ]
          }
        },
        "tree": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "2–3 levels only."
        },
        "recentlyChanged": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "readingOrder": {
      "type": "object",
      "required": [
        "stages",
        "nodes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "hook": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "description": "What the reader can do once they have finished the whole graph."
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readingStage"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readingNode"
          }
        }
      },
      "description": "A directed acyclic graph of the files to read, in an order where every file is explained by the ones before it. Each node is progress-tracked and markable complete directly on the graph. Deliberately NOT part of the section-progress denominator: \"files read\" and \"sections understood\" are different measures."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$",
      "description": "Permanent once published. Kind-prefixed, kebab-case, derived from meaning rather than position. Never renumber: reader progress is keyed on this."
    },
    "confidence": {
      "enum": [
        "verified",
        "inferred",
        "unknown"
      ],
      "description": "verified = stated by a comment, test, doc, commit, or observable behaviour. inferred = a reasonable conclusion from the implementation. unknown = the repository does not say."
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Repository-relative."
        },
        "symbol": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "kind": {
          "enum": [
            "code",
            "test",
            "config",
            "doc",
            "migration",
            "schema",
            "script",
            "commit"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "depth": {
      "type": "object",
      "required": [
        "simple",
        "balanced",
        "deep"
      ],
      "description": "All three are authored; balanced is the default reading level.",
      "properties": {
        "simple": {
          "type": "string"
        },
        "balanced": {
          "type": "string"
        },
        "deep": {
          "type": "string"
        }
      }
    },
    "why": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "q",
          "a"
        ],
        "properties": {
          "q": {
            "type": "string",
            "description": "Phrased as the reader would ask it."
          },
          "a": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceRef"
            }
          }
        }
      }
    },
    "changed": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "new",
            "updated",
            "unchanged",
            "removed"
          ]
        },
        "commit": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "conflict": {
      "type": "object",
      "description": "Documentation and implementation disagree. Never resolve this silently.",
      "properties": {
        "claim": {
          "type": "string"
        },
        "reality": {
          "type": "string"
        },
        "assessment": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "name",
        "path",
        "commit",
        "commitShort",
        "commitSubject",
        "commitTimestamp",
        "generatedAt",
        "workingTreeClean",
        "dirtyFiles",
        "detached",
        "atlasLocation"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "description": "Host and path only. Never credentials."
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "detached": {
          "type": "boolean"
        },
        "commit": {
          "type": "string"
        },
        "commitShort": {
          "type": "string"
        },
        "commitSubject": {
          "type": "string"
        },
        "commitTimestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootCommit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Identity check: proves an update targets the same repository."
        },
        "generatedAt": {
          "type": "string"
        },
        "workingTreeClean": {
          "type": "boolean"
        },
        "dirtyFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "lastValidatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "atlasLocation": {
          "enum": [
            "sibling",
            "inside-repo",
            "custom"
          ]
        },
        "gitExcludeApplied": {
          "type": "boolean"
        },
        "commitsBehind": {
          "type": "integer",
          "description": "Drives the staleness banner. Refreshed by audit and update."
        }
      }
    },
    "update": {
      "type": "object",
      "required": [
        "commit",
        "at",
        "mode",
        "summary"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "commitShort": {
          "type": "string"
        },
        "fromCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "create",
            "update",
            "migrate",
            "audit"
          ]
        },
        "summary": {
          "type": "string"
        },
        "changedSectionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removedSectionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commitsSpanned": {
          "type": "integer"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "oneLiner"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "oneLiner": {
          "type": "string",
          "description": "What the system does, in language a non-expert understands."
        },
        "hook": {
          "type": "string",
          "description": "The first thing a reader sees. True, specific to this repository, and answerable by the atlas."
        },
        "primaryLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sizeSignals": {
          "type": "object"
        },
        "scopeNote": {
          "type": "string",
          "description": "What this version deliberately does not cover."
        }
      }
    },
    "learningPath": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "stepIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "quick-overview",
            "follow-one-action",
            "explore",
            "continue",
            "what-changed",
            "review-unfinished",
            "reading-order"
          ]
        },
        "title": {
          "type": "string"
        },
        "blurb": {
          "type": "string"
        },
        "stepIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Step COUNT is shown to the reader — never a time estimate."
        },
        "summary": {
          "type": "string",
          "description": "what-changed only: the concept that moved, in one sentence."
        },
        "why": {
          "type": "string",
          "description": "what-changed only: the evidenced reason. Omit rather than guess."
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affectedIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Atlas ids this group touches. Defaults to stepIds when absent."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "documentationImpact": {
          "type": "string"
        },
        "reviewOrder": {
          "type": "integer",
          "description": "Recommended review order. Groups without one sort last, then by id."
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      },
      "description": "Also carries the conceptual change groups: kind \"what-changed\" with a stable path-change-* id. Progress stores whether a reader reviewed one; the atlas data never stores review state. Kind \"reading-order\" is a jump into the reading-order graph rather than a list of stops; its stepIds are the graph nodes."
    },
    "explorerGroup": {
      "type": "object",
      "required": [
        "id",
        "title",
        "what",
        "paths",
        "componentIds",
        "whyItMatters",
        "sources",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "technicalName": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "area",
            "district"
          ]
        },
        "what": {
          "type": "string",
          "description": "The responsibility, not the folder name."
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "componentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parentId": {
          "type": "string",
          "description": "The island this area sits under. Omit when it genuinely spans more than one."
        },
        "keyFileIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "whyItMatters": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "explorerFile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "path",
        "parentId",
        "responsibility",
        "whyItMatters",
        "sources",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "file"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "parentId": {
          "type": "string",
          "description": "Area id, or the component id when no area contains it."
        },
        "componentId": {
          "type": "string"
        },
        "responsibility": {
          "type": "string"
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "whyItMatters": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "changed": {
          "$ref": "#/$defs/changed"
        }
      },
      "description": "A selected, load-bearing file — never the whole tree. A moved file keeps its id and takes a new path."
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "responsibility",
        "depth",
        "sources",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "technicalName": {
          "type": "string",
          "description": "Package or service name, shown beside the friendly one."
        },
        "worldType": {
          "enum": [
            "island",
            "module"
          ],
          "description": "A module is nested inside its parent island."
        },
        "parentId": {
          "type": "string",
          "description": "Parent component id when worldType is \"module\"."
        },
        "category": {
          "enum": [
            "frontend",
            "admin",
            "mobile",
            "cli",
            "backend",
            "api",
            "worker",
            "domain",
            "shared-lib",
            "shared-ui",
            "database",
            "cache",
            "storage",
            "queue",
            "events",
            "external",
            "infra",
            "build",
            "tests"
          ]
        },
        "layer": {
          "type": "integer",
          "description": "0 = clients, increasing toward infrastructure. Drives map layout."
        },
        "map": {
          "type": "object",
          "description": "World placement. Presentation only — validate-atlas.mjs keeps it out of contentHash, so moving an island never tells readers its content changed.",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "layoutKey": {
              "type": "string",
              "description": "Stable placement input, e.g. \"layer-2:api\". Never random per render."
            },
            "theme": {
              "type": "string",
              "description": "Landmark vocabulary: harbor, vault, cave, lighthouse, workshop, watchtower, ruins…"
            }
          }
        },
        "accent": {
          "type": "string",
          "description": "Optional palette slot. Category shape and icon must still distinguish it — colour is never the only encoding."
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Only when repository evidence supports ownership."
        },
        "complexity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "health": {
          "type": "string"
        },
        "lastChangedCommit": {
          "type": "string"
        },
        "responsibility": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "entryPoint": {
          "$ref": "#/$defs/sourceRef"
        },
        "keyDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example": {
          "type": "string"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "depth": {
          "$ref": "#/$defs/depth"
        },
        "why": {
          "$ref": "#/$defs/why"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "minItems": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "changed": {
          "$ref": "#/$defs/changed"
        },
        "conflict": {
          "$ref": "#/$defs/conflict"
        },
        "mergedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids merged into this one; progress transfers once."
        },
        "contentHash": {
          "type": "string",
          "description": "Generated by validate-atlas.mjs. Do not hand-write."
        }
      }
    },
    "connection": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "mechanism"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "mechanism": {
          "enum": [
            "http",
            "rpc",
            "graphql",
            "server-action",
            "websocket",
            "sse",
            "queue",
            "event-bus",
            "webhook",
            "scheduled",
            "polling",
            "shared-storage",
            "ipc",
            "sql",
            "cache",
            "import"
          ]
        },
        "label": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "routeType": {
          "enum": [
            "sea-route",
            "current",
            "bridge",
            "ferry",
            "cargo",
            "cable",
            "air",
            "broken"
          ],
          "description": "How the route is drawn. A redundant encoding of the claim, never the claim itself — the semantic list still states mechanism, direction and confidence in words."
        },
        "relationshipType": {
          "type": "string",
          "description": "e.g. code-dependency, runtime-call, infrastructure-dependency, external-api."
        },
        "runtime": {
          "type": "boolean",
          "description": "true = data actually flows at runtime; false = a static relationship such as an import."
        },
        "strength": {
          "enum": [
            "weak",
            "normal",
            "tight"
          ]
        },
        "direction": {
          "enum": [
            "one-way",
            "two-way"
          ]
        },
        "validation": {
          "type": "string"
        },
        "auth": {
          "type": "string"
        },
        "onSuccess": {
          "type": "string"
        },
        "onFailure": {
          "type": "string"
        },
        "retry": {
          "type": "string"
        },
        "recovery": {
          "type": "string"
        },
        "whyThisMechanism": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "changed": {
          "$ref": "#/$defs/changed"
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "title",
        "steps",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
